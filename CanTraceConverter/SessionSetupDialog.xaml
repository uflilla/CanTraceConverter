<Window x:Class="CanTraceConverter.SessionSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CanTraceConverter.Controls"
        Title="New Monitor Session"
        Width="540"
        Height="600"
        MinWidth="480"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        FontFamily="Segoe UI"
        FontSize="14"
        ResizeMode="CanResize">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Margin="0,0,0,16" FontSize="18" FontWeight="SemiBold"
               Text="Session Setup" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Margin="0,0,0,4" FontWeight="Medium" Text="Session Title *" />
        <TextBox x:Name="txtTitle" Margin="0,0,0,12" Style="{StaticResource ModernTextBox}" />

        <TextBlock Margin="0,0,0,4" FontWeight="Medium" Text="USB-CAN Device" />
        <ComboBox x:Name="cmbDevice" Margin="0,0,0,8" Height="36" Padding="8,0"
                  VerticalContentAlignment="Center" DisplayMemberPath="DisplayName" />

        <Border x:Name="borderDeviceWarning" Margin="0,0,0,12" Padding="10,8"
                Background="#FFF8F0" BorderBrush="#E8C080" BorderThickness="1"
                CornerRadius="4" Visibility="Collapsed">
          <TextBlock x:Name="txtDeviceWarning" FontSize="12" Foreground="#A05800" TextWrapping="Wrap" />
        </Border>

        <TextBlock Margin="0,0,0,4" FontWeight="Medium" Text="CAN Channel" />
        <ComboBox x:Name="cmbChannel" Margin="0,0,0,12" Height="36" Padding="8,0" VerticalContentAlignment="Center">
          <ComboBoxItem Content="Channel 0" Tag="0" IsSelected="True" />
          <ComboBoxItem Content="Channel 1" Tag="1" />
        </ComboBox>

        <TextBlock Margin="0,0,0,4" FontWeight="Medium" Text="Baud Rate (kBit/s)" />
        <ComboBox x:Name="cmbBaud" Margin="0,0,0,12" Height="36" Padding="8,0" VerticalContentAlignment="Center">
          <ComboBoxItem Content="1000" Tag="1000" />
          <ComboBoxItem Content="800" Tag="800" />
          <ComboBoxItem Content="500" Tag="500" IsSelected="True" />
          <ComboBoxItem Content="250" Tag="250" />
          <ComboBoxItem Content="125" Tag="125" />
          <ComboBoxItem Content="100" Tag="100" />
          <ComboBoxItem Content="50" Tag="50" />
          <ComboBoxItem Content="20" Tag="20" />
          <ComboBoxItem Content="10" Tag="10" />
        </ComboBox>

        <CheckBox x:Name="chkListenOnly" Margin="0,0,0,4" IsChecked="True"
                  Content="Listen-only mode (passive monitoring, no transmit)" />
        <TextBlock Margin="0,0,0,12" FontSize="12" Foreground="#666666" TextWrapping="Wrap"
                   Text="Uncheck to enable Send CAN Packet in the monitor window." />

        <TextBlock Margin="0,0,0,4" FontWeight="Medium" Text="Log Directory" />
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="txtLogDir" Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource ModernTextBox}" />
          <Button Grid.Column="1" MinWidth="100" Click="BtnBrowseLog_Click"
                  Content="Browse..." Style="{StaticResource SecondaryButton}" />
        </Grid>

        <TextBlock x:Name="txtDbPreview" Margin="0,0,0,8" FontSize="12" Foreground="#666666" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button MinWidth="100" Margin="0,0,12,0" Click="BtnCancel_Click"
              Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" />
      <Button MinWidth="100" Click="BtnStart_Click" Content="Start"
              IsDefault="True" Style="{StaticResource ModernButton}" />
    </StackPanel>

    <controls:DeveloperFooter Grid.Row="3" Margin="0,12,0,0" />
  </Grid>
</Window>
