<Window
  x:Class="CanTraceConverter.AnalysisWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="clr-namespace:CanTraceConverter.Controls"
  Title="CAN Trace Analysis"
  Width="1400"
  Height="900"
  MinWidth="1200"
  MinHeight="700"
  Background="{DynamicResource ThemeBackgroundBrush}"
  FontFamily="Segoe UI"
  FontSize="14"
  WindowStartupLocation="CenterScreen"
  WindowState="Maximized"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="24,20"
            Background="{DynamicResource ThemeSurfaceBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock FontSize="20" FontWeight="SemiBold" Text="CAN Trace Analysis" />
          <TextBlock x:Name="txtSourceInfo" Margin="0,4,0,0" FontSize="13"
                     Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                     Text="Loading trace data..." TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
          <Border x:Name="badgeSource" Padding="10,4" Margin="0,0,8,0"
                  Background="{DynamicResource ThemeSurfaceAltBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}"
                  BorderThickness="1" CornerRadius="12">
            <TextBlock x:Name="txtSourceBadge" FontSize="12" FontWeight="SemiBold" Text="Source" />
          </Border>
          <Button x:Name="btnReload" MinWidth="90" Click="btnReload_Click"
                  Content="Reload" Style="{StaticResource SecondaryButton}"
                  ToolTip="Reload data from database file" Visibility="Collapsed" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24,20,24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Margin="0,0,12,0"
              Background="{DynamicResource ThemeSurfaceBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Margin="0,0,0,8" FontSize="15" FontWeight="SemiBold" Text="Filters" />

            <CheckBox x:Name="chkAutoApply" Margin="0,0,0,8" Content="Apply filters automatically"
                      IsChecked="True" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />

            <TextBlock Margin="0,4,0,4" FontWeight="Medium"
                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="Quick search:" />
            <TextBox x:Name="txtQuickSearch" Style="{StaticResource ModernTextBox}"
                     TextChanged="OnFilterChanged"
                     ToolTip="Search CAN ID, data, direction, or raw line" />

            <TextBlock Margin="0,12,0,4" FontWeight="Medium"
                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="Direction:" />
            <ComboBox x:Name="cmbDirection" SelectionChanged="OnFilterChanged"
                      Style="{StaticResource ModernComboBox}">
              <ComboBoxItem Content="All" IsSelected="True" />
              <ComboBoxItem Content="RX" />
              <ComboBoxItem Content="TX" />
            </ComboBox>

            <TextBlock Margin="0,12,0,4" FontWeight="Medium"
                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="CAN ID (hex):" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="txtCanIdFilter" Grid.Column="0"
                       Style="{StaticResource ModernTextBox}"
                       TextChanged="OnFilterChanged"
                       ToolTip="Enter CAN ID in hex (e.g., 321 or 0E0C0000)" />
              <Button x:Name="btnClearCanId" Grid.Column="1" Margin="4,0,0,0"
                      Padding="8,6" Click="btnClearCanId_Click"
                      Content="✕" Style="{StaticResource SecondaryButton}" />
            </Grid>

            <TextBlock Margin="0,12,0,4" FontWeight="Medium"
                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="DLC (Data Length):" />
            <ComboBox x:Name="cmbDlcFilter" SelectionChanged="OnFilterChanged"
                      Style="{StaticResource ModernComboBox}">
              <ComboBoxItem Content="All" IsSelected="True" />
              <ComboBoxItem Content="0" />
              <ComboBoxItem Content="1" />
              <ComboBoxItem Content="2" />
              <ComboBoxItem Content="3" />
              <ComboBoxItem Content="4" />
              <ComboBoxItem Content="5" />
              <ComboBoxItem Content="6" />
              <ComboBoxItem Content="7" />
              <ComboBoxItem Content="8" />
            </ComboBox>

            <TextBlock Margin="0,12,0,4" FontWeight="Medium"
                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="Time Range (msec):" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="txtTimeFrom" Grid.Column="0"
                       Style="{StaticResource ModernTextBox}"
                       TextChanged="OnFilterChanged" ToolTip="From (msec)" />
              <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="to" />
              <TextBox x:Name="txtTimeTo" Grid.Column="2"
                       Style="{StaticResource ModernTextBox}"
                       TextChanged="OnFilterChanged" ToolTip="To (msec)" />
            </Grid>

            <TextBlock Margin="0,12,0,4" FontWeight="Medium"
                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="Data Pattern (hex):" />
            <TextBox x:Name="txtDataPattern" Style="{StaticResource ModernTextBox}"
                     TextChanged="OnFilterChanged"
                     ToolTip="Search for hex pattern in data (e.g., 21 06)" />

            <TextBlock Margin="0,12,0,4" FontWeight="Medium"
                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="Source/Node ID (from CAN ID):" />
            <TextBox x:Name="txtSourceIdFilter" Style="{StaticResource ModernTextBox}"
                     TextChanged="OnFilterChanged"
                     ToolTip="Filter by source/node ID extracted from CAN ID" />

            <TextBlock Margin="0,12,0,4" FontWeight="Medium"
                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="Function Code (from data byte):" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Byte:" />
              <ComboBox x:Name="cmbFunctionCodeByte" Grid.Column="1" Margin="0,0,8,0"
                        SelectionChanged="OnFilterChanged"
                        Style="{StaticResource ModernComboBox}">
                <ComboBoxItem Content="0" IsSelected="True" />
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="3" />
                <ComboBoxItem Content="4" />
                <ComboBoxItem Content="5" />
                <ComboBoxItem Content="6" />
                <ComboBoxItem Content="7" />
              </ComboBox>
              <TextBox x:Name="txtFunctionCode" Grid.Column="2"
                       Style="{StaticResource ModernTextBox}"
                       TextChanged="OnFilterChanged" ToolTip="Value (hex)" />
            </Grid>

            <StackPanel Margin="0,12,0,0" Orientation="Vertical">
              <CheckBox x:Name="chkExtendedOnly" Content="Extended IDs only"
                        Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
              <CheckBox x:Name="chkHideRtr" Margin="0,6,0,0" Content="Hide RTR messages"
                        Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            </StackPanel>

            <StackPanel Margin="0,20,0,0" Orientation="Vertical">
              <Button Click="btnApplyFilters_Click" Content="Apply Filters"
                      Style="{StaticResource ModernButton}" />
              <Button Margin="0,8,0,0" Click="btnClearFilters_Click"
                      Content="Clear All Filters" Style="{StaticResource SecondaryButton}" />
              <Button Margin="0,8,0,0" Click="btnExportFiltered_Click"
                      Content="Export Filtered Data" Style="{StaticResource SecondaryButton}" />
            </StackPanel>

            <TextBlock Margin="0,24,0,8" FontSize="15" FontWeight="SemiBold" Text="Statistics" />
            <Border Padding="12"
                    Background="{DynamicResource ThemeSurfaceAltBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
              <TextBlock x:Name="txtStatistics" FontFamily="Consolas" FontSize="12"
                         Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
            </Border>

            <TextBlock Margin="0,16,0,4" FontWeight="Medium"
                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                       Text="Unique CAN IDs (click to filter):" />
            <ListBox x:Name="lstUniqueIds" Height="160"
                     DisplayMemberPath="DisplayText"
                     MouseDoubleClick="lstUniqueIds_MouseDoubleClick"
                     SelectionChanged="lstUniqueIds_SelectionChanged"
                     Style="{StaticResource ModernListBox}"
                     FontFamily="Consolas" FontSize="11" />

            <TextBlock Margin="0,16,0,8" FontSize="15" FontWeight="SemiBold" Text="Session / File Info" />
            <Border Padding="12"
                    Background="{DynamicResource ThemeSurfaceAltBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
              <TextBlock x:Name="txtFileInfo" FontFamily="Consolas" FontSize="11"
                         Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                         TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="1"
              Background="{DynamicResource ThemeSurfaceBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Padding="16,12"
                  Background="{DynamicResource ThemeSurfaceAltBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}"
                  BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" VerticalAlignment="Center"
                         FontWeight="SemiBold" Text="Analysis View" />

              <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <StackPanel x:Name="panelTimelineInterval" Margin="0,0,12,0"
                            VerticalAlignment="Center" Orientation="Horizontal"
                            Visibility="Collapsed">
                  <TextBlock Margin="0,0,6,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                             Text="Bucket (ms):" />
                  <TextBox x:Name="txtTimelineInterval" Width="70"
                           Style="{StaticResource ModernTextBox}"
                           Text="100" TextChanged="txtTimelineInterval_TextChanged" />
                </StackPanel>
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="View Mode:" />
                <ComboBox x:Name="cmbViewMode" Width="210"
                          SelectionChanged="cmbViewMode_SelectionChanged"
                          Style="{StaticResource ModernComboBox}">
                  <ComboBoxItem Content="All Messages" IsSelected="True" />
                  <ComboBoxItem Content="Latest per CAN ID" />
                  <ComboBoxItem Content="Unique CAN IDs" />
                  <ComboBoxItem Content="Data Changes" />
                  <ComboBoxItem Content="Inter-message Gaps" />
                  <ComboBoxItem Content="Message Timeline" />
                  <ComboBoxItem Content="Frequency Analysis" />
                </ComboBox>
              </StackPanel>
            </Grid>
          </Border>

          <DataGrid x:Name="dgMessages" Grid.Row="1" FontSize="14"
                    SelectionChanged="dgMessages_SelectionChanged"
                    Style="{StaticResource ModernDataGrid}">
            <DataGrid.Columns>
              <DataGridTextColumn Width="60" Binding="{Binding Direction}" Header="DIR" />
              <DataGridTextColumn Width="100" Binding="{Binding Time}" Header="TIME (msec)" />
              <DataGridTextColumn Width="110" Binding="{Binding CanId}" Header="CAN ID" />
              <DataGridTextColumn Width="50" Binding="{Binding Dlc}" Header="DLC" />
              <DataGridTextColumn Width="*" Binding="{Binding Data}" Header="DATA" />
            </DataGrid.Columns>
          </DataGrid>

          <Border x:Name="panelMessageDetail" Grid.Row="2" Padding="16,10"
                  Background="{DynamicResource ThemeSurfaceAltBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}"
                  BorderThickness="0,1,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Selected Message" />
              <TextBlock x:Name="txtMessageDetail" Margin="0,4,0,0"
                         FontFamily="Consolas" FontSize="12"
                         Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Grid.Row="3" Padding="16,8"
                  Background="{DynamicResource ThemeSurfaceAltBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}"
                  BorderThickness="0,1,0,0">
            <TextBlock x:Name="txtMessageCount" FontSize="12"
                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                       Text="0 messages displayed" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Padding="24,16"
            Background="{DynamicResource ThemeSurfaceBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="txtStatus" Grid.Column="0"
                   VerticalAlignment="Center" FontSize="13"
                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                   Text="Analysis ready" />

        <controls:DeveloperFooter Grid.Column="1" Margin="0,0,16,0" />

        <Button Grid.Column="2" MinWidth="100" Click="btnClose_Click"
                Content="Close" Style="{StaticResource SecondaryButton}" />
      </Grid>
    </Border>
  </Grid>
</Window>
