<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="false">
  <variable name="logDirectory" value="${basedir}/Logs" />
  <targets>
    <target xsi:type="File"
            name="appFile"
            fileName="${logDirectory}/CanTraceConverter-${shortdate}.log"
            archiveFileName="${logDirectory}/CanTraceConverter-${shortdate}.{#}.log"
            archiveAboveSize="10485760"
            archiveNumbering="Rolling"
            maxArchiveFiles="50"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="utf-8"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=ToString}}" />
  </targets>
  <rules>
    <logger name="*" minlevel="Info" writeTo="appFile" />
  </rules>
</nlog>
