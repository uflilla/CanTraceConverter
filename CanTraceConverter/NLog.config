<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="false">
  <!-- Per-user location: the install directory is often read-only for standard users.
       AppLog.Initialize overrides this with the folder it has verified is writable. -->
  <variable name="logDirectory" value="${specialfolder:folder=LocalApplicationData}/USB-CAN Studio/Logs" />
  <targets>
    <target xsi:type="File"
            name="appFile"
            fileName="${logDirectory}/CanTraceConverter-${shortdate}.log"
            archiveFileName="${logDirectory}/CanTraceConverter-${shortdate}.{#}.log"
            archiveAboveSize="10485760"
            archiveNumbering="Rolling"
            maxArchiveFiles="50"
            concurrentWrites="false"
            keepFileOpen="true"
            openFileCacheTimeout="30"
            encoding="utf-8"
            layout="${longdate}|${level:uppercase=true}|${threadid}|${logger}|${message}${onexception:${newline}${exception:format=ToString}}" />
  </targets>
  <rules>
    <logger name="*" minlevel="Info" writeTo="appFile" />
  </rules>
</nlog>
