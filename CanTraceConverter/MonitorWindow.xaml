<Window x:Class="CanTraceConverter.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CanTraceConverter.Controls"
        Title="CAN Monitor"
        Width="1100"
        Height="780"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        FontFamily="Segoe UI"
        FontSize="14"
        Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Padding="20,16" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="txtSessionTitle" FontSize="18" FontWeight="SemiBold" Foreground="#333333" />
          <TextBlock x:Name="txtConnectionInfo" Margin="0,4,0,0" FontSize="13" Foreground="#666666" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock x:Name="txtConnectionStatus" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0078D4" />
          <TextBlock x:Name="txtLogPath" Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="12" Foreground="#888888" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Live grid -->
    <Border Grid.Row="1" Margin="16,12,16,0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="14,10" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
          <Grid>
            <TextBlock FontWeight="SemiBold" Text="Live CAN Values (latest per ID)" />
            <TextBlock x:Name="txtLiveStats" HorizontalAlignment="Right" Foreground="#666666" />
          </Grid>
        </Border>
        <DataGrid x:Name="dgLive" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" FontFamily="Consolas" FontSize="13"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" IsReadOnly="True"
                  SelectionMode="Single">
          <DataGrid.Columns>
            <DataGridTextColumn Header="DIR" Binding="{Binding Direction}" Width="50" />
            <DataGridTextColumn Header="CAN ID" Binding="{Binding CanIdDisplay}" Width="100" />
            <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="45" />
            <DataGridTextColumn Header="DATA" Binding="{Binding Data}" Width="*" />
            <DataGridTextColumn Header="TIME (ms)" Binding="{Binding TimeDisplay}" Width="100" />
            <DataGridTextColumn Header="COUNT" Binding="{Binding MessageCount}" Width="70" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <!-- Send panel — always visible; disabled in listen-only mode -->
    <Border x:Name="panelSend" Grid.Row="2" Margin="16,12,16,0" Padding="16,14"
            Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
      <StackPanel>
        <Grid Margin="0,0,0,12">
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"
                     Text="Send CAN Packet" />
          <TextBlock x:Name="txtSendDisabledNotice" HorizontalAlignment="Right" VerticalAlignment="Center"
                     FontSize="12" Foreground="#C05000" Text="Transmit disabled — listen-only session"
                     Visibility="Collapsed" />
        </Grid>

        <Grid x:Name="gridSendControls">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="36" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" MinWidth="180" />
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Labels -->
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,6"
                     FontSize="12" Foreground="#666666" Text="CAN ID (hex)" />
          <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,12,6"
                     FontSize="12" Foreground="#666666" Text="Format" />
          <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,12,6"
                     FontSize="12" Foreground="#666666" Text="DLC" />
          <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,0,12,6"
                     FontSize="12" Foreground="#666666" Text="Data (hex)" />
          <TextBlock Grid.Row="0" Grid.Column="4" Margin="0,0,12,6"
                     FontSize="12" Foreground="#666666" Text="Interval" />
          <TextBlock Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="2" Margin="0,0,0,6"
                     FontSize="12" Foreground="#666666" Text="Transmit" />

          <!-- Inputs — fixed 36px row height -->
          <TextBox x:Name="txtSendId" Grid.Row="1" Grid.Column="0" Height="36" Margin="0,0,12,0"
                   VerticalContentAlignment="Center" Style="{StaticResource ModernTextBox}"
                   ToolTip="CAN ID (hex)" Text="100" />
          <CheckBox x:Name="chkExtended" Grid.Row="1" Grid.Column="1" Height="36" Margin="0,0,12,0"
                    VerticalAlignment="Center" VerticalContentAlignment="Center" Content="Extended" />
          <ComboBox x:Name="cmbSendDlc" Grid.Row="1" Grid.Column="2" Height="36" Margin="0,0,12,0"
                    VerticalContentAlignment="Center" SelectedIndex="8">
            <ComboBoxItem Content="0" Tag="0" />
            <ComboBoxItem Content="1" Tag="1" />
            <ComboBoxItem Content="2" Tag="2" />
            <ComboBoxItem Content="3" Tag="3" />
            <ComboBoxItem Content="4" Tag="4" />
            <ComboBoxItem Content="5" Tag="5" />
            <ComboBoxItem Content="6" Tag="6" />
            <ComboBoxItem Content="7" Tag="7" />
            <ComboBoxItem Content="8" Tag="8" />
          </ComboBox>
          <controls:HexByteEditor x:Name="hexSendData" Grid.Row="1" Grid.Column="3"
                                  Height="36" Margin="0,0,12,0" MaxBytes="8" />
          <TextBox x:Name="txtInterval" Grid.Row="1" Grid.Column="4" Height="36" Margin="0,0,12,0"
                   VerticalContentAlignment="Center" Style="{StaticResource ModernTextBox}"
                   Text="100" ToolTip="Periodic interval in milliseconds" />
          <Button x:Name="btnSendOnce" Grid.Row="1" Grid.Column="5" MinWidth="110"
                  Margin="0,0,8,0" Click="BtnSendOnce_Click"
                  Content="Send Once" Style="{StaticResource ModernButton}" />
          <Button x:Name="btnPeriodic" Grid.Row="1" Grid.Column="6" MinWidth="110"
                  Click="BtnPeriodic_Click" Content="Periodic TX" Style="{StaticResource SecondaryButton}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Footer: actions + status on separate rows -->
    <Border Grid.Row="3" Padding="16,14" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button MinWidth="150" Margin="0,0,12,0" Click="BtnAnalyze_Click"
                  Content="Analyze Session" Style="{StaticResource ModernButton}" />
          <Button MinWidth="150" Margin="0,0,12,0" Click="BtnExport_Click"
                  Content="Export to Text..." Style="{StaticResource SecondaryButton}" />
          <Button MinWidth="150" Margin="0,0,12,0" Click="BtnOpenLogDir_Click"
                  Content="Open Log Folder" Style="{StaticResource SecondaryButton}" />
          <Button x:Name="btnReconnect" MinWidth="130" Click="BtnReconnect_Click"
                  Content="Reconnect" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" />
        </StackPanel>

        <Border Margin="0,14,0,0" Padding="12,10" Background="#FAFAFA"
                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
          <TextBlock x:Name="txtStatus" MinHeight="20" Text="Ready"
                     TextWrapping="Wrap" Foreground="#555555" FontSize="13" />
        </Border>

        <controls:DeveloperFooter Margin="0,12,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
