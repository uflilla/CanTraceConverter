<Window x:Class="CanTraceConverter.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CanTraceConverter.Controls"
        Title="USB-CAN Studio"
        Width="560"
        Height="420"
        MinWidth="480"
        MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="16"
        ResizeMode="CanMinimize">
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,24">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="USB-CAN Studio" />
      <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                 Text="Monitor, record, convert and analyze Systec USB-CAN traces" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" VerticalAlignment="Center">
      <Button Margin="0,0,0,12" MinWidth="320" Click="BtnNewMonitor_Click"
              Content="New Monitor Session" Style="{StaticResource ModernButton}" />
      <Button Margin="0,0,0,12" MinWidth="320" Click="BtnConverter_Click"
              Content="Trace Converter (.ucantrc)" Style="{StaticResource SecondaryButton}" />
      <Button Margin="0,0,0,12" MinWidth="320" Click="BtnAnalyzeDb_Click"
              Content="Analyze Trace (Database or Text)" Style="{StaticResource SecondaryButton}" />
    </StackPanel>

    <controls:DeveloperFooter Grid.Row="2" />
  </Grid>
</Window>
