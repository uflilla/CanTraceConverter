<Window x:Class="UcanView.SdoPacketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UcanView.Controls"
        Title="UCAN View - SDO Packet Trace"
        Width="1300"
        Height="860"
        MinWidth="1000"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="14"
        Closed="Window_Closed">
  <Window.Resources>
    <Style x:Key="FilterLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
    </Style>

    <!-- Packets that did not arrive intact stand out from the complete ones. -->
    <Style x:Key="PacketRowStyle" TargetType="DataGridRow">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Incomplete">
          <Setter Property="Foreground" Value="{DynamicResource ThemeErrorTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Aborted">
          <Setter Property="Foreground" Value="{DynamicResource ThemeErrorTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Complete (unconfirmed)">
          <Setter Property="Foreground" Value="{DynamicResource ThemeWarningTextBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="150" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="150" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Padding="20,14"
            Background="{DynamicResource ThemeSurfaceBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="SDO Packet Trace" />
          <TextBlock x:Name="txtSource" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                     Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="Loading…" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
          <Border x:Name="badgeLive" Margin="0,0,12,0" Padding="10,4" CornerRadius="12"
                  Background="{DynamicResource ThemeSurfaceAltBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Visibility="Collapsed">
            <TextBlock x:Name="txtLive" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource ThemeAccentBrush}" Text="● LIVE" />
          </Border>
          <CheckBox x:Name="chkFollow" Margin="0,0,12,0" VerticalAlignment="Center" IsChecked="True"
                    Content="Follow newest" Visibility="Collapsed" />
          <Button x:Name="btnRefresh" MinWidth="90" Margin="0,0,8,0" Click="BtnRefresh_Click"
                  Content="Refresh" Style="{StaticResource SecondaryButton}" />
          <Button MinWidth="110" Margin="0,0,8,0" Click="BtnExportCsv_Click"
                  Content="Export CSV…" Style="{StaticResource SecondaryButton}"
                  ToolTip="Export the packets matching the filters" />
          <Button x:Name="btnSavePayload" MinWidth="120" Click="BtnSavePayload_Click" IsEnabled="False"
                  Content="Save Payload…" Style="{StaticResource SecondaryButton}"
                  ToolTip="Save the selected packet's payload as a binary file" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Filters -->
    <Border Grid.Row="1" Margin="16,12,16,0" Padding="14,10"
            Background="{DynamicResource ThemeSurfaceBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6">
      <WrapPanel>
        <StackPanel Margin="0,0,12,4" Width="90">
          <TextBlock Style="{StaticResource FilterLabel}" Text="Sender node" />
          <TextBox x:Name="txtSender" Style="{StaticResource ModernTextBox}" TextChanged="OnFilterChanged"
                   ToolTip="Node ID, decimal or hex (0x04 / 04h)" />
        </StackPanel>
        <StackPanel Margin="0,0,12,4" Width="90">
          <TextBlock Style="{StaticResource FilterLabel}" Text="Receiver node" />
          <TextBox x:Name="txtReceiver" Style="{StaticResource ModernTextBox}" TextChanged="OnFilterChanged"
                   ToolTip="Node ID, decimal or hex (0x01 / 01h)" />
        </StackPanel>
        <StackPanel Margin="0,0,12,4" Width="90">
          <TextBlock Style="{StaticResource FilterLabel}" Text="Index (hex)" />
          <TextBox x:Name="txtIndex" Style="{StaticResource ModernTextBox}" TextChanged="OnFilterChanged"
                   ToolTip="Object index, e.g. 6304" />
        </StackPanel>
        <StackPanel Margin="0,0,12,4" Width="190">
          <TextBlock Style="{StaticResource FilterLabel}" Text="Status" />
          <ComboBox x:Name="cmbStatus" Style="{StaticResource ModernComboBox}" SelectionChanged="OnFilterChanged">
            <ComboBoxItem Content="All" IsSelected="True" />
            <ComboBoxItem Content="Complete" />
            <ComboBoxItem Content="Not complete" />
            <ComboBoxItem Content="Incomplete" />
            <ComboBoxItem Content="Aborted" />
            <ComboBoxItem Content="Complete (unconfirmed)" />
          </ComboBox>
        </StackPanel>
        <StackPanel Margin="0,0,12,4" Width="110">
          <TextBlock Style="{StaticResource FilterLabel}" Text="From (ms)" />
          <TextBox x:Name="txtFrom" Style="{StaticResource ModernTextBox}" TextChanged="OnFilterChanged" />
        </StackPanel>
        <StackPanel Margin="0,0,12,4" Width="110">
          <TextBlock Style="{StaticResource FilterLabel}" Text="To (ms)" />
          <TextBox x:Name="txtTo" Style="{StaticResource ModernTextBox}" TextChanged="OnFilterChanged" />
        </StackPanel>
        <StackPanel Margin="0,0,12,4" Width="220">
          <TextBlock Style="{StaticResource FilterLabel}" Text="Payload contains (hex)" />
          <TextBox x:Name="txtPayload" Style="{StaticResource ModernTextBox}" TextChanged="OnFilterChanged"
                   ToolTip="Hex bytes anywhere in the payload, e.g. 08 04 C1" />
        </StackPanel>
        <Button Margin="0,18,0,4" MinWidth="90" VerticalAlignment="Top" Click="BtnClearFilters_Click"
                Content="Clear" Style="{StaticResource SecondaryButton}" />
      </WrapPanel>
    </Border>

    <!-- Packets -->
    <Border Grid.Row="2" Margin="16,12,16,0"
            Background="{DynamicResource ThemeSurfaceBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6">
      <DataGrid x:Name="dgPackets" Style="{StaticResource ModernDataGrid}" SelectionMode="Single"
                RowStyle="{StaticResource PacketRowStyle}"
                SelectionChanged="DgPackets_SelectionChanged">
        <DataGrid.Columns>
          <DataGridTextColumn Header="START (ms)" Binding="{Binding StartTimeDisplay}" Width="100" />
          <DataGridTextColumn Header="CLOCK" Binding="{Binding StartClockDisplay}" Width="95" />
          <DataGridTextColumn Header="DUR (ms)" Binding="{Binding DurationDisplay}" Width="70" />
          <DataGridTextColumn Header="SENDER" Binding="{Binding SenderDisplay}" Width="75" />
          <DataGridTextColumn Header="RECEIVER" Binding="{Binding ReceiverDisplay}" Width="75" />
          <DataGridTextColumn Header="SDO#" Binding="{Binding SdoNumber}" Width="50" />
          <DataGridTextColumn Header="TYPE" Binding="{Binding TransferType}" Width="80" />
          <DataGridTextColumn Header="MODE" Binding="{Binding Mode}" Width="85" />
          <DataGridTextColumn Header="INDEX" Binding="{Binding IndexDisplay}" Width="60" />
          <DataGridTextColumn Header="SUB" Binding="{Binding SubIndexDisplay}" Width="45" />
          <DataGridTextColumn Header="BYTES" Binding="{Binding SizeDisplay}" Width="75" />
          <DataGridTextColumn Header="FRAMES" Binding="{Binding FrameCount}" Width="60" />
          <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="150" />
          <DataGridTextColumn Header="PAYLOAD" Binding="{Binding PayloadPreview}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <GridSplitter Grid.Row="3" Height="6" Margin="16,0" HorizontalAlignment="Stretch"
                  VerticalAlignment="Center" Background="{DynamicResource ThemeBorderBrush}"
                  ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Cursor="SizeNS" />

    <!-- Selected packet -->
    <Border Grid.Row="4" Margin="16,0,16,0" Padding="14,10"
            Background="{DynamicResource ThemeSurfaceBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="txtSummary" Grid.ColumnSpan="3" Margin="0,0,0,8"
                 FontFamily="Consolas" FontSize="12" IsReadOnly="True" BorderThickness="0"
                 Background="Transparent" Padding="0" TextWrapping="Wrap"
                 Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                 Text="Select a packet to see its full payload and the frames it was sent in." />

        <Grid Grid.Row="1" Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="Payload" />
          <!-- Read-only TextBox so bytes can be selected and copied. -->
          <TextBox x:Name="txtPayloadDump" Grid.Row="1" FontFamily="Consolas" FontSize="12"
                   IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                   Background="{DynamicResource ThemeInputBackgroundBrush}"
                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                   BorderBrush="{DynamicResource ThemeBorderBrush}" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="txtFramesHeader" FontWeight="SemiBold" Margin="0,0,0,4" Text="Frames" />
          <DataGrid x:Name="dgFrames" Grid.Row="1" Style="{StaticResource ModernDataGrid}"
                    BorderThickness="1">
            <DataGrid.Columns>
              <DataGridTextColumn Header="TIME (ms)" Binding="{Binding TimeDisplay}" Width="90" />
              <DataGridTextColumn Header="COB-ID" Binding="{Binding CobIdDisplay}" Width="85" />
              <DataGridTextColumn Header="FROM" Binding="{Binding SenderNodeId}" Width="45" />
              <DataGridTextColumn Header="TO" Binding="{Binding ReceiverNodeId}" Width="40" />
              <DataGridTextColumn Header="DATA" Binding="{Binding DataHex}" Width="165" />
              <DataGridTextColumn Header="COMMAND" Binding="{Binding Command}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Grid>
    </Border>

    <!-- Status -->
    <Border Grid.Row="5" Margin="0,12,0,0" Padding="16,10"
            Background="{DynamicResource ThemeSurfaceBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel>
        <TextBlock x:Name="txtStatus" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="Loading…" />
        <controls:DeveloperFooter Margin="0,8,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
